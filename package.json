{
  "name": "uae-open-intelligence",
  "version": "0.1.0",
  "description": "UAE Open Intelligence Platform — Arabic-first data observatory, analytics & API hub for UAE open data.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "build-db": "tsx scripts/build-db.ts",
